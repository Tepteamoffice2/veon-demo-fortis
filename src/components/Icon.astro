---
// Inline SVG icons (no icon font). Decorative: the control around it carries the name.
interface Props { name: "phone" | "arrow" | "menu" | "close" | "mail" | "pin"; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.8 1.8 0 0 1-1.9 1.8A16.8 16.8 0 0 1 3.2 5.4 1.8 1.8 0 0 1 5 3.5Z" />}
  {name === "arrow" && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === "menu" && <path d="M3 7h18M3 12h18M3 17h18" />}
  {name === "close" && <path d="M5 5l14 14M19 5L5 19" />}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === "pin" && <><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>}
</svg>
