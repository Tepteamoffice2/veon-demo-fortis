---
// Footer: dark deep band, no wordmark. Contacts, future sections (FutureLink), licence, confirmed social profiles, current year.
import FutureLink from "./FutureLink.astro";
import { phone, phoneHref, email, emailHref, address, metro, license, socials, soon } from "../data/site";
const future = ["Про центр", "Фахівці", "Ціни", "Розклад", "Статті", "Відгуки", "Контакти", "Політика конфіденційності", "Правила"];
const year = new Date().getFullYear();
---
<footer class="footer on-deep">
  <div class="container footer__grid">
    <div class="footer__about">
      <p class="footer__name">Медичний оздоровчий центр «Fortis»</p>
      <p class="footer__muted">{license}</p>
      <a class="footer__top" href="#top">На початок сторінки</a>
    </div>
    <div class="footer__contacts">
      <h2 class="footer__h">Контакти</h2>
      <a class="footer__phone" href={phoneHref}>{phone}</a>
      <a href={emailHref}>{email}</a>
      <p class="footer__muted">Харків, {address}, {metro}</p>
    </div>
    <nav class="footer__nav" aria-label="Розділи сайту">
      <h2 class="footer__h">Розділи</h2>
      <ul data-rec="R-UX-10">
        {future.map((f) => <li><FutureLink note={soon}>{f}</FutureLink></li>)}
      </ul>
    </nav>
    <div class="footer__social" data-rec="S-R009">
      <h2 class="footer__h">Ми в мережах</h2>
      <ul>
        {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.name}<span class="visually-hidden"> (нова вкладка)</span></a></li>)}
      </ul>
    </div>
  </div>
  <div class="container footer__base">
    <p>© {year} Fortis Health</p>
  </div>
</footer>

<style>
  .footer { background: var(--color-deep); color: var(--color-on-deep); padding-block: var(--space-5) var(--space-3); }
  .footer a { color: var(--color-on-deep); text-underline-offset: 0.2em; }
  .footer a:hover { color: var(--color-medicine); }
  .footer a:active { color: var(--color-on-deep-muted); }
  .footer__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-3); row-gap: var(--space-4); }
  .footer__about { grid-column: 1 / span 4; display: grid; gap: var(--space-2); align-content: start; justify-items: start; }
  .footer__contacts { grid-column: 5 / span 3; display: grid; gap: var(--space-1); align-content: start; justify-items: start; }
  .footer__nav { grid-column: 8 / span 3; }
  .footer__social { grid-column: 11 / span 2; }
  .footer__name { font: 600 var(--fs-h3)/1.2 var(--font-display); max-width: 16ch; }
  .footer__muted { color: var(--color-on-deep-muted); font-size: var(--fs-small); }
  .footer__h { font: 600 1rem/1.3 var(--font-body); color: var(--color-medicine); margin-bottom: var(--space-15); }
  .footer__phone { font: 600 1.375rem/1.2 var(--font-display); text-decoration: none; }
  .footer ul { list-style: none; display: grid; gap: var(--space-1); }
  .footer :global(.future-link) { color: var(--color-on-deep-muted); }
  .footer__base { margin-top: var(--space-5); padding-top: var(--space-3); border-top: 1px solid var(--color-deep-2); font-size: var(--fs-small); color: var(--color-on-deep-muted); }

  @media (max-width: 1023px) {
    .footer__about, .footer__contacts { grid-column: span 6; }
    .footer__nav, .footer__social { grid-column: span 6; }
  }
  @media (max-width: 767px) {
    .footer__about, .footer__contacts, .footer__nav, .footer__social { grid-column: 1 / -1; }
    .footer { padding-bottom: calc(var(--space-3) + 4.5rem + env(safe-area-inset-bottom)); } /* room for the bottom call bar */
  }
</style>
