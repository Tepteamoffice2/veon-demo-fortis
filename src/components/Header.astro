---
import { Image } from "astro:assets";
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import logo from "../assets/brand/fortis-logo.svg";
import logoCompact from "../assets/brand/fortis-logo-compact.svg";
import { nav, navFuture, phone, phoneHref, email, emailHref, address, soon } from "../data/site";
---
<header class="site-header" data-rec="R-UX-02,R-UX-06,R-UX-11,S-R008,G-R001">
  <div class="container site-header__bar">
    <a class="site-header__logo" href="#top" aria-label="Fortis Health, на початок сторінки">
      <Image src={logo} alt="" class="logo-full" width={112} height={55} loading="eager" />
      <Image src={logoCompact} alt="" class="logo-compact" width={78} height={41} loading="eager" />
    </a>

    <nav class="site-nav" aria-label="Основна навігація">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        {navFuture.map((l) => <li><FutureLink note={soon}>{l}</FutureLink></li>)}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={phoneHref}>{phone}</a>
      <a class="btn site-header__book" href="#zapys">Записатися</a>
      <span class="site-header__lang"><span aria-current="true" lang="uk">UA</span><FutureLink note={soon} class="future-link--end"><span lang="ru">RU</span></FutureLink></span>
      <a class="icon-btn site-header__call" href={phoneHref} aria-label={"Подзвонити " + phone}><Icon name="phone" /></a>
      <button class="icon-btn site-header__burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Відкрити меню">
        <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
      </button>
    </div>
  </div>

  <div class="menu" id="menu">
    <nav class="container menu__inner" aria-label="Меню">
      <ul class="menu__list">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        {navFuture.map((l) => <li><FutureLink note={soon}>{l}</FutureLink></li>)}
        <li><FutureLink note={soon}>Російська версія</FutureLink></li>
      </ul>
      <div class="menu__contacts">
        <a class="menu__phone" href={phoneHref}>{phone}</a>
        <a class="text-link" href={emailHref}>{email}</a>
        <p>Харків, {address}</p>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".site-header__burger");
  const menu = document.getElementById("menu");
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Закрити меню" : "Відкрити меню");
      menu.classList.toggle("is-open", open);
    };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    // Anchor in the overlay: close the menu first, then scroll to the target in the next frame (scroll-margin-top is respected).
    menu.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>("a[href^='#']");
      if (!link) return;
      const id = link.getAttribute("href")!.slice(1);
      const target = id ? document.getElementById(id) : null;
      set(false);
      if (!target) return;
      e.preventDefault();
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      requestAnimationFrame(() => {
        target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
        history.pushState(null, "", "#" + id);
      });
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.classList.contains("is-open")) { set(false); btn.focus(); }
    });
    matchMedia("(min-width: 1200px)").addEventListener("change", (e) => { if (e.matches) set(false); });
  }
</script>

<style>
  .site-header { position: relative; z-index: 40; background: var(--color-bg); border-bottom: 1px solid var(--color-line); }
  :global(.js) .site-header { position: sticky; top: 0; }
  .site-header__bar { display: flex; align-items: center; gap: var(--space-3); min-height: var(--header-h); }
  .site-header__logo { display: block; flex: none; }
  .logo-full { height: 3.25rem; width: auto; }
  .logo-compact { display: none; height: 2.5rem; width: auto; }

  .site-nav { margin-left: auto; }
  .site-nav ul { display: flex; align-items: center; gap: var(--space-3); list-style: none; }
  .site-nav a, .site-nav :global(.future-link) { font-size: 0.9375rem; font-weight: 500; color: var(--color-text); padding-block: var(--space-1); }
  .site-nav a { text-decoration: none; background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat; transition: background-size 200ms var(--ease-out); }
  .site-nav a:hover { background-size: 100% 1px; }
  .site-nav a:active { color: var(--color-deep); }
  .site-nav :global(.future-link) { color: var(--color-muted); }

  .site-header__actions { display: flex; align-items: center; gap: var(--space-2); }
  .site-header__phone { font: 600 1.0625rem/1 var(--font-display); text-decoration: none; color: var(--color-text); white-space: nowrap; }
  .site-header__phone:hover { color: var(--color-link); }
  .site-header__phone:active { color: var(--color-deep); }
  .site-header__book { min-height: 3rem; }
  .site-header__lang { display: inline-flex; gap: var(--space-1); font-size: 0.875rem; color: var(--color-muted); }
  .site-header__lang [aria-current] { color: var(--color-text); font-weight: 600; }

  .icon-btn { display: none; place-items: center; width: 3rem; height: 3rem; border: 0; padding: 0; background: none; color: var(--color-text); cursor: pointer; }
  .icon-btn :global(svg) { width: 1.5rem; height: 1.5rem; }
  .icon-btn:hover { color: var(--color-link); }
  .icon-btn:active { transform: scale(.94); }
  .site-header__call { background: var(--color-accent); color: var(--color-deep); }
  .site-header__call:hover { background: var(--color-accent-hover); color: var(--color-deep); }
  .site-header__burger :global(.i-close) { display: none; }
  .site-header__burger[aria-expanded="true"] :global(.i-open) { display: none; }
  .site-header__burger[aria-expanded="true"] :global(.i-close) { display: block; }

  /* overlay menu (below 1200). Without scripts it stays open in the flow, so every anchor is reachable. */
  .menu { display: none; }
  @media (max-width: 1199px) {
    .site-nav, .site-header__lang { display: none; }
    .site-header__actions { margin-left: auto; }
    .icon-btn { display: grid; }
    :global(html:not(.js)) .site-header__burger { display: none; }
    .menu { display: block; border-top: 1px solid var(--color-line); padding-block: var(--space-3); }
    :global(.js) .menu { position: fixed; inset: var(--header-h) 0 0 0; overflow-y: auto; background: var(--color-bg); visibility: hidden; opacity: 0; transform: translateY(-8px);
      transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out), visibility 0s linear 200ms; }
    :global(.js) .menu.is-open { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
    .menu__inner { display: grid; gap: var(--space-4); }
    .menu__list { list-style: none; display: grid; }
    .menu__list a, .menu__list :global(.future-link) { display: flex; min-height: 3rem; align-items: center; font: 600 1.375rem/1.2 var(--font-display); color: var(--color-text); }
    .menu__list a { text-decoration: none; }
    .menu__list :global(.future-link) { color: var(--color-muted); }
    .menu__list a:hover { color: var(--color-link); }
    .menu__contacts { display: grid; gap: var(--space-1); padding-top: var(--space-3); border-top: 1px solid var(--color-line); }
    .menu__phone { font: 700 1.75rem/1.2 var(--font-display); text-decoration: none; color: var(--color-text); }
  }
  @media (max-width: 767px) {
    .logo-full, .site-header__phone, .site-header__book { display: none; }
    .logo-compact { display: block; }
    .site-header__actions { gap: var(--space-1); }
  }
</style>
