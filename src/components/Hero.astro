---
import Section from "./Section.astro";
import Facets from "./Facets.astro";
import Icon from "./Icon.astro";
import { phone, phoneHref, address } from "../data/site";
---
<Section id="top" rec="R-UX-01" class="hero">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 class="hero__title" data-rec="R-SEO-07,G-R001,MA-R003">Лікуємо хребет і суглоби <span class="nobr">рухом —</span> у Харкові</h1>
      <p class="hero__lead">
        <span class="hero__lead-long">Медичний оздоровчий центр Fortis: спершу лікар і діагностика на тренажерах DAVID, далі кінезітерапія, ЛФК, масаж і фітнес. Для дорослих і дітей.</span>
        <span class="hero__lead-short">Лікар, діагностика DAVID, ЛФК, масаж і фітнес — для дорослих і дітей.</span>
      </p>
      <div class="hero__actions">
        <a class="btn hero__call" href={phoneHref}><Icon name="phone" />Подзвонити {phone}</a>
        <a class="text-link" href="#zvernennia">З чим ми допомагаємо</a>
      </div>
      <p class="hero__address"><Icon name="pin" />{address}, м. «Ботанічний сад»</p>
    </div>
    <figure class="hero__route">
      <Facets variant="hero" />
      <figcaption class="hero__caption">Перший крок — діагностичне заняття: 85&nbsp;хв, 1100&nbsp;грн</figcaption>
    </figure>
  </div>
</Section>

<style>
  :global(.hero) { padding-block: var(--space-5); }
  @media (min-width: 1024px) { :global(.hero) { display: grid; align-content: center; min-height: min(calc(100svh - var(--header-h)), 60rem); } }
  .hero__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-3); row-gap: var(--space-4); align-items: center; }
  .hero__text { grid-column: 1 / span 8; }
  .hero__route { margin: 0; grid-column: 9 / span 4; display: grid; gap: var(--space-3); padding-bottom: var(--space-1); }
  .hero__title { font-size: var(--fs-h1); line-height: var(--lh-h1); letter-spacing: -0.02em; color: var(--color-text); max-width: 8.9em; }
  .hero__lead { margin-top: var(--space-3); font-size: var(--fs-lead); line-height: 1.45; max-width: 24em; color: var(--color-text); }
  .hero__lead-short { display: none; }
  .nobr { white-space: nowrap; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); margin-top: var(--space-4); }
  .hero__address { display: flex; align-items: center; gap: var(--space-1); margin-top: var(--space-3); font-size: var(--fs-small); color: var(--color-muted); }
  .hero__address :global(svg) { width: 1.125rem; height: 1.125rem; flex: none; }
  .hero__caption { font-size: var(--fs-small); color: var(--color-muted); max-width: 16em; }

  @media (max-width: 1023px) {
    :global(.hero) { padding-block: var(--space-4) var(--space-5); }
    .hero__grid { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-3); }
    .hero__text, .hero__route { grid-column: 1 / -1; }
    .hero__route { gap: var(--space-15); padding-bottom: 0; }
    .hero__caption { max-width: none; }
  }
  @media (max-width: 767px) {
    :global(.hero) { padding-block: var(--space-3) var(--space-4); }
    .hero__title { max-width: none; }
    .hero__lead { margin-top: var(--space-2); }
    .hero__lead-long { display: none; }
    .hero__lead-short { display: inline; }
    .hero__actions { margin-top: var(--space-3); gap: var(--space-2); }
    .hero__call { width: 100%; }
    .hero__address { margin-top: var(--space-2); }
  }
</style>
